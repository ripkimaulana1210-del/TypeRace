# ==============================================================================
# TYPERACE 3D - ENVIRONMENT CONFIGURATION (PROXMOX PVE / PRODUCTION)
# ==============================================================================

# Mode Aplikasi
NODE_ENV=production

# Port internal server Node.js
PORT=3000

# CORS & Socket.IO Allowed Origin
# Gunakan '*' untuk menerima koneksi dari mana saja, atau tentukan domain Cloudflare Tunnel:
CLIENT_ORIGIN=https://typerace.aceasa.web.id

# ==============================================================================
# POSTGRESQL DATABASE (CT 102)
# ==============================================================================
# Format URL: postgres://<user>:<password>@<ip_ct_102>:<port>/<db_name>
DATABASE_URL=postgres://typerace_user:typerace_password@192.168.44.132:5432/typerace_db

# Alternatif parameter individu (jika DATABASE_URL tidak digunakan):
PGHOST=192.168.44.132
PGPORT=5432
PGUSER=typerace_user
PGPASSWORD=typerace_password
PGDATABASE=typerace_db
